# Monorepo root gitignore

# Node files
node_modules/
dist/
dist-ssr/
*.local

# Python files
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/

# Environment files
.env
.env.local
.env.development
.env.production

# Database
*.sqlite3
*.sqlite3-journal
backend/db.sqlite3
backend/db.sqlite3-journal

# IDE files and OS garbage
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
